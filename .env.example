# ===== 在 Vercel 專案的 Environment Variables 全部設定 =====

# Supabase 專案（Project Settings > API）
SUPABASE_URL=https://你的專案.supabase.co
SUPABASE_SERVICE_ROLE_KEY=你的 service_role key

# 網站正式網址（Email 重設信連結用，不要加結尾斜線）
APP_URL=https://你的-app.vercel.app

# 郵件服務：Resend（免費層 3000 封/月、100 封/日；只寄驗證信與重設信）
RESEND_API_KEY=re_你的金鑰
EMAIL_FROM=班級訂午餐 <no-reply@你的網域>

# 推播通知 VAPID 金鑰（在本機執行 npm run generate:vapid 產生）
VAPID_PUBLIC_KEY=你的公開金鑰
VAPID_PRIVATE_KEY=你的私密金鑰

# 排程金鑰：api/cron 的保護密碼（自訂一串隨機字元）
CRON_SECRET=請換成隨機字串

# 開發者金鑰：開發者註冊時需要輸入的金鑰（自訂一串長隨機字元）
DEVELOPER_MASTER_KEY=請換成另一串隨機字元
